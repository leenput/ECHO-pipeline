# workflow/Snakefile

# ----- PREPARATION -----

# pull in shared config, variables, paths, helpers and all_inputs
include: "rules/setup_and_targets.smk"

# ----- GENERAL LOG -----

# Create a logfile 
include: "rules/log_generation.smk"

# ============================================================
# UPSTREAM PROCESSING
# Skip this entire section when resuming from phased outputs
# ============================================================

if not RESUME_FROM_PHASED: 

    # -------  STEP 0: PREPROCESSING  -------

    # basecalling
    if START_FROM == "pod5":
        include: "rules/basecalling.smk"
        include: "rules/ubam_to_fastq.smk"

    # ubam to fastq conversion
    elif START_FROM == "ubam":
        include: "rules/ubam_to_fastq.smk"


    # fastq QC: quality control and read filtering 
    include: "rules/QC_fastq.smk"

    # -------  STEP 1: ALIGNMENT -------

    include: "rules/alignment.smk"

    # -------  STEP 2: VARIANT CALLING -------

    # SNVs and Indels
    include: "rules/variant_calling_snps_indels.smk"

    # SVs
    include: "rules/variant_calling_sv.smk"

    # -------  STEP 3: PHASING AND HAPLOTAGGING -------

    # Phasing 
    include: "rules/phasing.smk"

# ============================================================
# DOWNSTREAM PROCESSING
# Always available
# ============================================================

# VCF filtering
include: "rules/VCF_filtering.smk"

# QC phasing
include: "rules/QC_phasing.smk"
include: "rules/sex_from_cramino.smk"

# -------  STEP 4 : METHYLATION CALLING -------

include: "rules/methylation_calling.smk"

# -------  STEP 5 : NON-REF TE CALLING -------

include: "rules/TE_calling.smk"

# -------  STEP 6 : TR CALLING -------

include: "rules/TR_calling.smk"

# -------  STEP 7 : TR METHYLATION CALLING -------

include: "rules/TR_vcf_filtering.smk"
include: "rules/TR_methylation_calling.smk"

# -------  STEP 8 : TE METHYLATION CALLING -------

# non-ref TEs
include: "rules/non_ref_TE_methylation_calling.smk"

# ref TEs
include: "rules/ref_TE_methylation_calling_cpg_res.smk"
include: "rules/ref_TE_methylation_calling_averages.smk"

rule all:
    input:
        all_inputs


#Remove file where date for log file is printed 
onsuccess:
    import os
    RUN_ID_FILE = ".snakemake/run_id.json"
    if os.path.exists(RUN_ID_FILE):
        os.remove(RUN_ID_FILE)

onerror:
    import os
    RUN_ID_FILE = ".snakemake/run_id.json"
    if os.path.exists(RUN_ID_FILE):
        os.remove(RUN_ID_FILE)
